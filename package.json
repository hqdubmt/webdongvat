{
  "name": "masterlms",
  "version": "1.0.0",
  "private": true,
  "description": "MasterLMS - Vietnamese Wildlife Species Management System",
  "scripts": {
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "install:api": "cd apps/api && npm install",
    "install:web": "cd apps/web && npm install",
    "install:all": "npm run install:api && npm run install:web",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "db:generate": "cd apps/api && npm run prisma:generate",
    "db:migrate": "cd apps/api && npm run prisma:migrate",
    "db:seed": "cd apps/api && npm run prisma:seed",
    "db:setup": "cd apps/api && npm run setup",
    "docker:up": "cd infra/docker && docker compose up -d",
    "docker:down": "cd infra/docker && docker compose down",
    "docker:logs": "cd infra/docker && docker compose logs -f",
    "docker:build": "cd infra/docker && docker compose build"
  }
}
